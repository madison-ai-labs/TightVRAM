# Like coding-pf, but ub 8192 and only 64k context: for long prompts under 64k.
# Prefill 16k/64k: 3590/2768 t/s (coding-pf: 2438/2051). ub 8192 does not fit at 128k (compute buffer 3842 MiB).
GGML_SCHED_PREFETCH_EXPERTS=3
LLAMA_ARGS=-m /path/to/models/Qwen3.6-35B-A3B-UD-Q4_K_XL.gguf --alias qwen3.6-35b-a3b-fast -ngl 99 -ncmoe 40 -fa on -t 10 -b 8192 -ub 8192 -c 65536 -np 1 --fit off --cache-ram 4096 --load-mode dio --mmproj /path/to/models/Qwen3.6-35B-A3B-mmproj-F16.gguf --no-mmproj-offload
