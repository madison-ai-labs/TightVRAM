# Like coding (stock build), but experts pinned: agent turns and long documents 10-12 % faster, short questions equal.
# Cost: ~20 GiB permanently bound, load 14 s instead of 1.8 s warm. Nothing RAM-hungry may run next to it.
LLAMA_ARGS=-m /path/to/models/Qwen3.6-35B-A3B-UD-Q4_K_XL.gguf --alias qwen3.6-35b-a3b-dio -ngl 99 -ncmoe 40 -fa on -t 10 -b 4096 -ub 4096 -c 131072 -np 1 --fit off --cache-ram 4096 --load-mode dio
