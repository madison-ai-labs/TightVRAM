         ggml_backend_tensor_get_async(backend, ids, st.ids_data.data(), 0, ggml_nbytes(ids));
         ggml_backend_synchronize(backend);
+        if (pfx) pfx_ids = (ggml_time_us() - pfx_t0)/1000.0;
 
         st.used.assign(n_expert, false);
         for (int64_t i1 = 0; i1 < ids->ne[1]; i1++) {
@@ -3060,11 +3065,21 @@ bool llama_context::sched_copy_experts(ggml_backend_t backend, const ggml_tensor
         const size_t size    = (last + 1 - next)*expert_size + padding;
         if (size > 0) {
             ggml_backend_tensor_set_async(backend, dst, (const uint8_t *) src->data + offset, offset, size);
+            pfx_bytes += size;
         }
 
         first = last + 1;
     }
 
+    if (pfx) {
+        ggml_backend_synchronize(backend);
+        int64_t n_used = 0;
+        for (bool u : st.used) n_used += u;
+        fprintf(stderr, "PFX E %s tok=%lld used=%lld/%lld bytes=%zu ids_ms=%.3f up_ms=%.3f\n",
+            src->name, (long long) ids->ne[1], (long long) n_used, (long long) n_expert, pfx_bytes, pfx_ids,
+            (ggml_time_us() - pfx_t0)/1000.0 - pfx_ids);
+    }
+
     return true;
 }
 
