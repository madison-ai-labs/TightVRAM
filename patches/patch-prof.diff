     const int64_t n_expert    = src->ne[2];
     const size_t  expert_size = src->nb[2];
 
+    static const int pfx = getenv("LLAMA_PREFILL_PROF") ? atoi(getenv("LLAMA_PREFILL_PROF")) : 0;
+    const int64_t pfx_t0 = pfx ? ggml_time_us() : 0;
